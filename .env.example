# ==============================================================================
# FINDIT NEARBY: Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND VARIABLES (Client-safe, prefixed with VITE_)
# ------------------------------------------------------------------------------
# Your Supabase project URL (found in Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase public anonymous API key (found in Project Settings > API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Google Maps JavaScript API key (for interactive location picker)
VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# SERVER-SIDE SECRETS (NEVER commit or prefix with VITE_)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (used only in Edge Functions / Backend administration)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: OpenAI / Gemini API Key (for server-side semantic embeddings & summaries)
AI_API_KEY=
